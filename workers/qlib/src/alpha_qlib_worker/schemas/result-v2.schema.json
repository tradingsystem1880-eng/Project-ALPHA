{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-alpha.local/contracts/qlib/result-v2.schema.json",
  "title": "Project ALPHA isolated rank ensemble worker result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "request_sha256", "snapshot_hash", "config_hash",
    "worker_lock_hash", "seed", "worker", "predictions", "ensemble_diagnostics",
    "diagnostics", "diagnostic_only", "counterfactual_refit"
  ],
  "properties": {
    "schema_version": {"const": 2}, "status": {"const": "succeeded"},
    "request_sha256": {"$ref": "#/$defs/hash"}, "snapshot_hash": {"$ref": "#/$defs/hash"},
    "config_hash": {"$ref": "#/$defs/hash"}, "worker_lock_hash": {"$ref": "#/$defs/hash"},
    "seed": {"type": "integer", "minimum": 0},
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "implementation_version"],
      "properties": {
        "kind": {"enum": ["fake", "qlib"]},
        "implementation_version": {"type": "string", "minLength": 1}
      }
    },
    "predictions": {"$ref": "#/$defs/parquet"},
    "ensemble_diagnostics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"const": "QlibRankEnsembleDiagnosticsV1"},
        "schema_version": {"const": 1},
        "path": {"const": "ensemble_diagnostics.parquet"},
        "sha256": {"$ref": "#/$defs/hash"},
        "rows": {"type": "integer", "minimum": 1}
      },
      "required": ["schema", "schema_version", "path", "sha256", "rows"]
    },
    "diagnostics": {"type": "object"},
    "diagnostic_only": {"const": true}, "counterfactual_refit": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parquet": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "rows"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"},
        "rows": {"type": "integer", "minimum": 1}, "schema": {"type": "string"},
        "schema_version": {"type": "integer", "minimum": 1}
      }
    }
  }
}
