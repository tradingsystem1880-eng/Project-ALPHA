# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling caches
.venv/
.venv-*/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
# The built Workstation SPA: `npm run build` in apps/alpha-web/frontend writes it; CI builds it.
apps/alpha-web/src/alpha_web/static/app/
# CI coverage and shard outputs (scripts/gate_components.py)
coverage.xml
diff-coverage.md
pytest-shard-*.xml
test-durations.json
htmlcov/
.hypothesis/
.import_linter_cache/
mutants/
*.log

# uv
# (uv.lock IS committed — do not ignore it)

# Env / secrets
.env
.env.*
# Example env templates stay committable (none are tracked today).
!.env.example

# macOS
.DS_Store

# Node / frontend build (the BUILT assets under src/alpha_web/static/app ARE committed;
# node_modules + TS build info are not)
node_modules/
coverage/
apps/alpha-web/frontend/playwright-report/
apps/alpha-web/frontend/test-results/
*.tsbuildinfo

# Data is large + reproducible from snapshots; never commit it
data/
.quantpad/
# Local scratch (benchmark renders, throwaway scripts); archive outside the repo
tmp/

# Claude Code harness: local overrides + machine-local state (stamps, audit, session
# journals) stay out of the tree; .claude/settings.json and skills/agents/commands ARE
# committed
.claude/settings.local.json
.claude/*.local.json
.claude/state/
.claude/worktrees/
.claude/agent-memory/
.claude/agent-memory-local/

# Agent-neutral local verification receipts; historical Claude state stays ignored.
.alpha/state/
